{
  "components": {
    "schemas": {
      "EntryRequest": {
        "properties": {
          "amount": {
            "description": "Valor positivo, no máximo 2 casas decimais. O tipo define o sinal.",
            "example": 150.75,
            "minimum": 0.01,
            "type": "number"
          },
          "date": {
            "description": "Data financeira no fuso do comerciante. Não pode ser futura nem anterior a 365 dias.",
            "example": "2026-10-13",
            "format": "date",
            "type": "string"
          },
          "description": {
            "description": "Obrigatória e não pode ser vazia.",
            "example": "Venda balcão",
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "enum": [
              "CREDIT",
              "DEBIT"
            ],
            "example": "CREDIT",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "date",
          "description",
          "type"
        ],
        "type": "object"
      },
      "EntryResponse": {
        "properties": {
          "amount": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "reversalOf": {
            "format": "uuid",
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProblemDetail": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "object"
            },
            "type": "object"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ReversalRequest": {
        "properties": {
          "reason": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Registro de créditos e débitos do comerciante. No ambiente local a página já abre autorizada com um token de teste; basta usar Try it out e Execute. Todo POST exige o header Idempotency-Key (8 a 100 caracteres): repetir a mesma chave devolve o lançamento original (200), sem duplicar.",
    "title": "Lançamentos",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/lancamentos": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "example": "2026-10-13",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 50,
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EntryResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Lançamentos da data, em ordem de registro"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Parâmetros inválidos"
          },
          "401": {
            "description": "Token ausente, inválido ou expirado (header WWW-Authenticate: Bearer)"
          },
          "403": {
            "description": "Token válido, mas sem o escopo exigido pela operação"
          },
          "429": {
            "description": "Limite de requisições por token excedido (aplicado pelo gateway)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Lista os lançamentos de uma data",
        "tags": [
          "lancamentos"
        ]
      },
      "post": {
        "description": "Idempotente pela Idempotency-Key: repetir a mesma requisição retorna o lançamento original (200).",
        "operationId": "register",
        "parameters": [
          {
            "description": "Chave única por intenção de lançamento (8 a 100 caracteres)",
            "example": "venda-0001-2026-10-13",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_\\-:.]{8,100}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResponse"
                }
              }
            },
            "description": "Repetição idempotente: mesma Idempotency-Key e mesmo payload; devolve o lançamento original",
            "headers": {
              "Idempotent-Replayed": {
                "description": "Sempre \"true\"",
                "style": "simple"
              }
            }
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResponse"
                }
              }
            },
            "description": "Lançamento criado",
            "headers": {
              "Location": {
                "description": "URI do lançamento criado",
                "style": "simple"
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Payload inválido ou Idempotency-Key ausente/fora do padrão"
          },
          "401": {
            "description": "Token ausente, inválido ou expirado (header WWW-Authenticate: Bearer)"
          },
          "403": {
            "description": "Token válido, mas sem o escopo exigido pela operação"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Idempotency-Key já usada com payload diferente"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Regra de negócio violada (ex.: data futura, valor fora do limite)"
          },
          "429": {
            "description": "Limite de requisições por token excedido (aplicado pelo gateway)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Registra um crédito ou débito",
        "tags": [
          "lancamentos"
        ]
      }
    },
    "/api/v1/lancamentos/{id}": {
      "get": {
        "operationId": "get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResponse"
                }
              }
            },
            "description": "Lançamento"
          },
          "401": {
            "description": "Token ausente, inválido ou expirado (header WWW-Authenticate: Bearer)"
          },
          "403": {
            "description": "Token válido, mas sem o escopo exigido pela operação"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Não encontrado para este comerciante"
          },
          "429": {
            "description": "Limite de requisições por token excedido (aplicado pelo gateway)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Consulta um lançamento pelo id",
        "tags": [
          "lancamentos"
        ]
      }
    },
    "/api/v1/lancamentos/{id}/estornos": {
      "post": {
        "operationId": "reverse",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "example": "estorno-0001-2026-10-13",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_\\-:.]{8,100}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReversalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResponse"
                }
              }
            },
            "description": "Repetição idempotente do mesmo estorno",
            "headers": {
              "Idempotent-Replayed": {
                "description": "Sempre \"true\"",
                "style": "simple"
              }
            }
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResponse"
                }
              }
            },
            "description": "Estorno criado",
            "headers": {
              "Location": {
                "description": "URI do estorno criado",
                "style": "simple"
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Requisição inválida"
          },
          "401": {
            "description": "Token ausente, inválido ou expirado (header WWW-Authenticate: Bearer)"
          },
          "403": {
            "description": "Token válido, mas sem o escopo exigido pela operação"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Lançamento não encontrado para este comerciante"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Idempotency-Key já usada com payload diferente"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Lançamento já estornado, ou tentativa de estornar um estorno"
          },
          "429": {
            "description": "Limite de requisições por token excedido (aplicado pelo gateway)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Estorna um lançamento (cria lançamento inverso na data de hoje)",
        "tags": [
          "lancamentos"
        ]
      }
    },
    "/dev/token": {
      "post": {
        "description": "Sem merchantId, cria um comerciante novo. Copie o access_token e use em Authorize.",
        "operationId": "token",
        "parameters": [
          {
            "in": "query",
            "name": "merchantId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "required": false,
            "schema": {
              "default": "lancamentos:write lancamentos:read consolidado:read",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "object"
                  },
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Gera um JWT de teste (somente profile local)",
        "tags": [
          "dev-token"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Gateway que serviu esta especificação",
      "url": "/"
    },
    {
      "description": "Gateway local (Docker Compose, porta padrão)",
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "description": "Registro, estorno e consulta de lançamentos",
      "name": "lancamentos"
    },
    {
      "description": "Emissão de token para testes locais (substitui o IdP)",
      "name": "dev-token"
    }
  ]
}
