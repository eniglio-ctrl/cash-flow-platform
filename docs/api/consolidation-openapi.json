{
  "openapi": "3.1.0",
  "info": {
    "title": "Consolidado diário",
    "description": "Saldo diário consolidado (eventualmente consistente). No ambiente local a autorização é automática e vale para as duas APIs.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Gateway"
    }
  ],
  "tags": [
    {
      "name": "consolidados",
      "description": "Saldo consolidado por dia e por período"
    },
    {
      "name": "admin",
      "description": "Operação: reprocessamento da DLQ"
    }
  ],
  "paths": {
    "/api/v1/admin/dlq/replay": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Reenvia mensagens da DLQ para o tópico principal (escopo consolidado:admin)",
        "operationId": "replay",
        "parameters": [
          {
            "name": "max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/consolidados": {
      "get": {
        "tags": [
          "consolidados"
        ],
        "summary": "Saldos consolidados de um intervalo (máx. 31 dias)",
        "operationId": "range",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-10-01"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-10-13"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DailyBalance"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/consolidados/{date}": {
      "get": {
        "tags": [
          "consolidados"
        ],
        "summary": "Saldo consolidado de um dia",
        "description": "Eventualmente consistente: o cabeçalho X-Consistency informa o modelo.",
        "operationId": "day",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-10-13"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBalance"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DailyBalance": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "openingBalance": {
            "type": "number"
          },
          "totalCredits": {
            "type": "number"
          },
          "totalDebits": {
            "type": "number"
          },
          "netAmount": {
            "type": "number"
          },
          "closingBalance": {
            "type": "number"
          },
          "entriesCount": {
            "type": "integer",
            "format": "int32"
          },
          "lastUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
